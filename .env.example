# Base URL REST API backend (Go + PostGIS) yang berjalan LOKAL.
# Jalankan backend dengan PORT=4000 (port 3000 dipakai Next.js).
# Produksi (https://rongsokin.hallojanu.me) mengisi nilai ini saat build Docker
# (lihat deploy/deploy.sh) — jangan arahkan dev ke API produksi.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Realtime (notifikasi & live tracking) memakai WebSocket di <API_URL>/ws.
# Isi hanya bila endpoint WS berbeda, mis. ws://localhost:4000/api/v1/ws
# NEXT_PUBLIC_WS_URL=

# URL publik situs (metadata/OG/sitemap). Default: https://rongsokin.hallojanu.me
# NEXT_PUBLIC_SITE_URL=

# OCR KTP saat KYC (opsional). Tanpa ini otomatis fallback ke Tesseract.js,
# jadi aplikasi tetap jalan tanpa key ini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Secret untuk menandatangani hasil OCR KTP (server-side, JANGAN pakai prefix NEXT_PUBLIC_).
# Harus SAMA dengan KYC_ATTESTATION_SECRET di backend. Min 32 karakter.
# Kosong = tidak ada attestation → backend (bila mewajibkan) tak akan menandai akun terverifikasi.
KYC_ATTESTATION_SECRET=
